# Copy to .env and fill in. .env is gitignored.

# Composio: search, scrape, browser, and the toolkit registry.
COMPOSIO_API_KEY=

# Which provider serves the extraction call: groq, anthropic, or claude-cli.
SCOUT_LLM=groq

# Groq, OpenAI-compatible at https://api.groq.com/openai/v1
GROQ_API_KEY=

# Only needed when SCOUT_LLM=anthropic.
ANTHROPIC_API_KEY=

# Optional override. Defaults per provider:
#   groq        openai/gpt-oss-20b
#   anthropic   claude-sonnet-5
#   claude-cli  whatever the CLI picks
SCOUT_MODEL=
